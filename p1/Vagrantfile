# frozen_string_literal: true
#
# Inception-of-Things - Part 1
# ------------------------------------------------------------------
# Two lightweight VMs, brought up with Vagrant, each running K3s:
#
#   amatteiS  (192.168.56.110) -> K3s server  (control-plane / "controller")
#   amatteiSW (192.168.56.111) -> K3s agent   (worker, joins amatteiS)
#
# Provider: libvirt (QEMU), driver "qemu" = pure software emulation.
# This host is itself a VM: every attempt at *hardware-accelerated*
# nested virtualization here (VirtualBox nested-hw-virt, KVM) has
# frozen the physical machine. Software emulation is slower but has
# never done that, so it's what we use.
#
# The K3s join token is handed from amatteiS to amatteiSW over Vagrant's
# own SSH channel (a `trigger` reads it out, a `file` provisioner writes
# it back in) rather than through a /vagrant synced folder - portable
# across providers and needs no extra host-side setup (e.g. NFS).

NODES = {
  "amatteiS"  => { ip: "192.168.56.110", role: "server" },
  "amatteiSW" => { ip: "192.168.56.111", role: "agent"  },
}.freeze

TOKEN_FILE = File.join(__dir__, ".node-token")

# The "file" provisioner for amatteiSW is validated (must exist) before
# ANY machine is brought up, but its real content is only produced by
# amatteiS's trigger during that same `vagrant up` run. Pre-create an
# empty placeholder so a fresh `vagrant up` passes validation; the
# trigger overwrites it with the real token before amatteiSW ever
# reads it (amatteiS is always provisioned first).
File.write(TOKEN_FILE, "") unless File.exist?(TOKEN_FILE)

Vagrant.configure("2") do |config|
  # generic/debian12: a cloud-init based Debian 12 box maintained for
  # portability across providers (virtualbox, libvirt, qemu, ...).
  config.vm.box = "generic/debian12"
  config.vm.box_check_update = false

  # Modern practice: let Vagrant generate & install a fresh SSH keypair
  # per machine instead of reusing the well-known insecure Vagrant key.
  # This is what gives us password-less, key-based SSH out of the box.
  config.ssh.insert_key = true

  NODES.each do |name, opts|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: opts[:ip]

      node.vm.provider "libvirt" do |lv|
        lv.driver  = "qemu"
        # The subject suggests 512-1024MB as a bare minimum; under pure
        # TCG software emulation that is not enough headroom for K3s
        # (its embedded etcd/API-server/controller alone wants ~500MB+)
        # and causes constant swapping inside the guest. Raised for
        # stability; safe to lower on hardware with working nested accel.
        lv.memory  = 2048
        lv.cpus    = 1
      end

      if opts[:role] == "server"
        node.vm.provision "shell",
          path: "scripts/setup_server.sh",
          env: { "NODE_IP" => opts[:ip] }
      else
        node.vm.provision "file",
          source: TOKEN_FILE,
          destination: "/tmp/node-token"

        node.vm.provision "shell",
          path: "scripts/setup_worker.sh",
          env: {
            "NODE_IP"   => opts[:ip],
            "SERVER_IP" => NODES["amatteiS"][:ip],
          }
      end
    end
  end

  # Defined at the top level (not nested inside vm.define) so Vagrant
  # reliably registers it: runs on the host right after amatteiS
  # finishes provisioning, pulling the K3s join token over SSH into a
  # local file that amatteiSW's file provisioner then uploads.
  #
  # Hooked on :up rather than :provision: a `:provision`-scoped trigger
  # only fires for the standalone `vagrant provision` command, NOT when
  # provisioning happens as an internal sub-step of `vagrant up` (which
  # is how this actually runs in practice).
  config.trigger.after :up, only_on: "amatteiS" do |trigger|
    trigger.info = "Fetching K3s join token from amatteiS..."
    trigger.ruby do |_env, machine|
      token = +""
      machine.communicate.sudo("cat /var/lib/rancher/k3s/server/node-token") do |type, data|
        token << data if type == :stdout
      end
      File.write(TOKEN_FILE, token.strip)
    end
  end
end
