# frozen_string_literal: true
#
# Inception-of-Things - Part 2
# ------------------------------------------------------------------
# One VM (amatteiS - 192.168.56.110) running K3s in server mode.
# Once K3s is up, the provisioning script deploys three small web
# applications and an Ingress that routes on the Host header:
#   app1.com -> app1   app2.com -> app2 (3 replicas)   default -> app3
#
# Provider: libvirt (QEMU), driver "qemu" = pure software emulation -
# see p1/Vagrantfile for why (hardware-accelerated nested virt freezes
# this particular host).

Vagrant.configure("2") do |config|
  config.vm.box = "generic/debian12"
  config.vm.box_check_update = false
  config.ssh.insert_key = true

  config.vm.define "amatteiS" do |node|
    node.vm.hostname = "amatteiS"
    node.vm.network "private_network", ip: "192.168.56.110"

    node.vm.provider "libvirt" do |lv|
      lv.driver = "qemu"
      # See p1/Vagrantfile: raised above the subject's suggested 512-1024MB
      # minimum because pure TCG software emulation leaves K3s too little
      # headroom otherwise. Safe to lower on hardware with working nested
      # acceleration.
      lv.memory = 2048
      lv.cpus   = 1
    end

    # Upload the k8s manifests over SSH instead of relying on a /vagrant
    # synced folder (libvirt doesn't mount one by default; this way
    # works identically on every provider).
    node.vm.provision "file", source: "confs", destination: "/tmp/confs"

    node.vm.provision "shell",
      path: "scripts/setup_server.sh",
      env: { "NODE_IP" => "192.168.56.110" }
  end
end
